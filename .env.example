# ============================================================
# Rojas Street Food - Variables de entorno
# Copiá este archivo como .env.local para desarrollo local
# Agregalas en Vercel > Settings > Environment Variables para producción
# ============================================================

# Supabase (Project Settings > API)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...

# Solo para API routes (NO usar VITE_ prefix - no se expone al frontend)
SUPABASE_URL=https://xxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# Resend (resend.com > API Keys)
RESEND_API_KEY=re_xxxxxxxxxxxx

# Email del remitente (debe estar verificado en Resend)
# Para pruebas podés usar: onboarding@resend.dev
RESEND_FROM_EMAIL=Rojas Street Food <noreply@rojasstreetfood.com>

# Email del dueño del restaurante (recibe notificación de recompensas)
OWNER_EMAIL=dueño@ejemplo.com

# URL base del sitio (para generar QR codes)
APP_URL=https://rojasstreetfood.vercel.app
